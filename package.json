{
  "name": "team-dev-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tda/cli dev",
    "typecheck": "pnpm -r --no-bail typecheck",
    "verify": "bash scripts/verify.sh",
    "start:all": "bash scripts/dev.sh",
    "eval": "pnpm --filter @tda/eval eval",
    "test": "pnpm -r --no-bail --if-present test",
    "prepare": "husky",
    "docs:dev": "pnpm docs:gen && vitepress dev docs/site",
    "docs:build": "pnpm docs:gen && vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site",
    "docs:gen": "node scripts/generate-skills-docs.mjs && node scripts/generate-eval-docs.mjs",
    "graph": "madge --image docs/dependency-graph.svg --extensions ts,svelte apps packages",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf dist .turbo"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "commitlint": "^21.2.3",
    "concurrently": "^10.0.6",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "version": "1.14.0",
  "license": "MIT",
  "description": "面向研发团队的 AI Agent 工具集：一条命令启动代码评审、问题排查、Issue 汇总三类 Agent，支持 CLI / A2A / MCP 接入，多 Agent 协作。内置可观测性（LLM/Agent trace）、安全加固（防命令注入/路径穿越）与评估体系（回归用例），开箱可用。",
  "packageManager": "pnpm@12.14.0"
}
