{
  "$schema": "https://raw.githubusercontent.com/k08200/mcp-probe/main/schemas/mcp-probe.sidecar.schema.json",
  "tools": {
    "read_file": {
      "input": {
        "path": "package.json"
      }
    },
    "search_code": {
      "input": {
        "query": "dependencies"
      }
    },
    "list_issues": {
      "input": {
        "owner": "timerwhou",
        "repo": "team-dev-assistant"
      },
      "expect": {
        "not_error_code": [
          401,
          403
        ]
      }
    }
  }
}
