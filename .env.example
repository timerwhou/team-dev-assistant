# --- 思考模型 (LLM) 配置 ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
GITHUB_TOKEN=

# --- 向量模型 (Embedding) 配置 ---
# 选项: openai / ollama / mock
EMBEDDING_PROVIDER=openai

# 【方案 A：使用任何兼容 OpenAI 格式的供应商】（如 DeepSeek, 智谱, OneAPI）
# 如果不填，默认复用上面的 OPENAI_API_KEY 和 OPENAI_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# 【方案 B：使用本地 Ollama】
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
