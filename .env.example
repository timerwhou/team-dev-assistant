# --- 思考模型 (LLM) 配置 ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
GITHUB_TOKEN=

# --- 向量模型 (Embedding) 配置 ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 如果使用 Ollama，请取消注释并配置
# EMBEDDING_PROVIDER=ollama
# OLLAMA_MODEL=nomic-embed-text

# --- MCP Server 传输与安全配置 (v1.3.0) ---
# 传输模式: stdio (默认) 或 http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000

# 【降级模式】静态 API Key（仅用于本地开发/过渡期）
MCP_API_KEY=your-secure-token

# 【生产模式】OAuth 2.1 资源服务器（配置后优先于 MCP_API_KEY）
# 企业 IdP 的 Issuer (例如 https://dev-xxx.okta.com)
OAUTH_ISSUER=
# 企业 IdP 的 JWKS 端点 (例如 https://dev-xxx.okta.com/oauth2/default/v1/keys)
OAUTH_JWKS_URI=
# 本 MCP Server 的公开访问地址 (用于 RFC 8707 aud 校验，例如 https://mcp.example.com)
MCP_CANONICAL_URI=

# ================= MCP Enterprise Security =================
# OAuth 2.1 multi-tenant isolation is enabled by default when OAUTH_ISSUER is set.
# The token's "tenant_id" claim will isolate the storage and playbook execution.
# Default rate limit is 60 requests per 60 seconds per tenant.
# MCP_RATE_LIMIT_MAX=60
# MCP_RATE_LIMIT_WINDOW_MS=60000
