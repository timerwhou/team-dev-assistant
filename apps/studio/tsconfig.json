{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "test",
    "*"
  ],
  "exclude": [
    "src/service-worker"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"],
      "@tda/core": ["../../packages/core/src/index.ts"],
      "@tda/core/*": ["../../packages/core/src/*"]
    }
  }
}
